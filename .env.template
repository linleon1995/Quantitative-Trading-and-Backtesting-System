# ============================================================================
# Live Trading Configuration Template
# ============================================================================
# Copy this file to .env and fill in your values
# See CONFIG_GUIDE.md for detailed documentation

# ============================================================================
# API Credentials (REQUIRED)
# ============================================================================
# Get testnet keys from: https://testnet.binancefuture.com/
# Get production keys from: https://www.binance.com/en/my/settings/api-management
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here
BINANCE_API_KEY=your_production_api_key_here
BINANCE_API_SECRET=your_production_api_secret_here

# ============================================================================
# Trading Configuration
# ============================================================================
# Use Binance testnet (True) or production (False)
# ALWAYS start with testnet!
USE_TESTNET=True

# Starting capital in USDT
INITIAL_CAPITAL=100000

# Maximum number of concurrent positions
# Start with 1, increase gradually as you gain confidence
MAX_POSITIONS=1

# Target value per trade in USDT
# Keep small initially (e.g., 100-500 USDT)
TRADE_VALUE_USDT=100

# Trading fee rate as decimal (0.0004 = 0.04%)
# Binance futures default: 0.04% for taker orders
# Adjust based on your VIP level
TRADING_FEE_RATE=0.0004

# Maximum allowed drawdown before auto-stop (0.2 = 20%)
# CRITICAL SAFETY PARAMETER - System stops trading when exceeded
# Recommended: 0.1 to 0.3 (10% to 30%)
MAX_DRAWDOWN=0.2

# Minimum 24-hour quote volume (in USDT) for a symbol to be traded.
# Symbols below this threshold are excluded at startup and ignored for the
# entire session.  Set to 0 to disable (trade all symbols).
# Example: 150000000 = 150 M USDT
TRADING_MIN_24H_VOLUME_USDT=0

# ============================================================================
# Strategy Parameters
# ============================================================================
# Number of periods for lookback window
# Higher = smoother but slower to react
STRATEGY_LOOKBACK=14

# Upper breakout threshold multiplier (0.0-1.0)
# Lower value = tighter entry conditions
STRATEGY_PR_X=0.8

# Lower breakout threshold multiplier (0.0-1.0)
# Lower value = tighter entry conditions
STRATEGY_PR_Y=0.7

# ATR (Average True Range) calculation period
STRATEGY_ATR_PERIOD=14

# ADX (Average Directional Index) calculation period
STRATEGY_ADX_PERIOD=14

# Maximum risk per trade as fraction of capital (0.02 = 2%)
STRATEGY_MAX_RISK=0.02

# Trading leverage (1-125)
# WARNING: Higher leverage = higher risk
# Start with 1 (no leverage)
STRATEGY_LEVERAGE=1

# Drawback percentage for exit condition (0.05 = 5%)
# Higher = more room for retracement before exit
STRATEGY_DRAWBACK=0.05

# Minimum holding time before exit (minutes)
# Prevents rapid entry/exit
STRATEGY_HOLD_MINUTES=60

# ============================================================================
# Signal Filters (set to 0 to disable each filter)
# ============================================================================
# Minimum ATR as a fraction of price (e.g. 0.003 = 0.3%).
# Prevents low-price / low-volatility coins (e.g. DOGE, SHIB) from triggering
# because their tiny absolute ATR collapses dynamic_x ≈ rolling_high.
# Rule of thumb: 0.003–0.01 for futures trading.
STRATEGY_MIN_ATR_PCT=0.003

# Minimum ADX value to confirm trend strength (0 = disabled).
# Values > 20 indicate a trend; < 20 indicates a ranging/choppy market.
STRATEGY_MIN_ADX=0.0

# Minimum notional volume per bar in USDT (volume * price). 0 = disabled.
# Filters out illiquid coins that are hard to fill at market price.
# e.g. 10000 means at least $10k notional volume per 1m bar.
STRATEGY_MIN_VOLUME_USDT=0.0

# Volume surge multiplier: volume must exceed mean_vol * this ratio.
# 1.0 = original behaviour (volume > mean). 1.5 = require 50% above average.
STRATEGY_MIN_VOL_RATIO=1.0

# Absolute price range filter (0 = disabled).
# e.g. STRATEGY_MIN_PRICE=0.01 skips sub-cent tokens.
STRATEGY_MIN_PRICE=0.0
STRATEGY_MAX_PRICE=0.0

# ============================================================================
# Kafka Configuration
# ============================================================================
# Comma-separated list of Kafka bootstrap servers
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Kafka topic to consume market data from
KAFKA_TOPIC=binance_kline

# ============================================================================
# Logging & Notifications
# ============================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Number of daily rotated log files to keep (older files are deleted automatically)
LOG_BACKUP_DAYS=30

# Path to log file (relative to project root)
LOG_FILE=logs/live_trading.log

# Interval for Telegram portfolio updates (seconds)
# 600 = 10 minutes, 300 = 5 minutes
TELEGRAM_UPDATE_INTERVAL=600

# Interval for portfolio tracking/sync with exchange (seconds)
# 300 = 5 minutes, 60 = 1 minute
PORTFOLIO_TRACKING_INTERVAL=300

# ============================================================================
# Telegram Bot (for notifications)
# ============================================================================
# Your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram chat ID (get from @userinfobot)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
